# Kopie als .env.local anlegen und Werte eintragen.

# Pflicht: ohne diesen Key wird keine Mail verschickt und das Formular
# zeigt dem Besucher einen Fehler mit WhatsApp-/Mail-Alternative.
# Key erstellen unter https://resend.com/api-keys
RESEND_API_KEY=

# Optional: Empfängeradresse (Standard: info@schuck.digital)
CONTACT_TO_EMAIL=

# Optional: Absender. Standard ist "Schuck Digital <website@schuck.digital>".
# Die Adresse muss auf einer in Resend verifizierten Domain liegen.
CONTACT_FROM_EMAIL=
