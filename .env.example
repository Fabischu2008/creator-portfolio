# Kopie als .env.local anlegen und Werte eintragen.

# Pflicht: ohne diesen Key wird keine Mail verschickt und das Formular
# zeigt dem Besucher einen Fehler mit WhatsApp-/Mail-Alternative.
# Key erstellen unter https://resend.com/api-keys
RESEND_API_KEY=

# Optional: Empfängeradresse (Standard: fabianschuck13@gmail.com)
CONTACT_TO_EMAIL=

# Optional: Absender. Standard ist Resends Testadresse, die ohne eigene
# Domain funktioniert. Sobald eine Domain in Resend verifiziert ist, hier
# z. B. "Schuck Digital <kontakt@schuck.digital>" eintragen.
CONTACT_FROM_EMAIL=
